# Godot import cache and editor state
.godot/
export_presets.cfg

# Large Mixamo downloads are not tracked: they are freely re-downloadable and
# would dominate the repo. The game runs without them via the articulated
# stand-in character. See docs/ASSET_GUIDE.md for how to fetch them.
assets/mixamo/characters/*
!assets/mixamo/characters/.gitkeep
assets/mixamo/raw/*
!assets/mixamo/raw/.gitkeep
assets/mixamo/retargeted/*
!assets/mixamo/retargeted/.gitkeep

# Weapon models ARE tracked: the whole set is ~440 KB of CC0 glTF, small
# enough to ship so a fresh clone has real guns in hand. Only the Mixamo
# character/animation downloads above are too big to version.

# Preview renders, regenerated by tools/CharacterPreview.tscn and
# tools/RosterPreview.tscn
preview.png
ingame.png
roster.png

# Orphaned import sidecars for preview renders
*.png.import
!icon.svg.import
